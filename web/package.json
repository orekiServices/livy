{
  "name": "livy-console",
  "version": "3.10.0",
  "private": true,
  "type": "module",
  "description": "Livy web console \u2014 a Next export served by the radio node, and optionally a Next server of its own.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "build:server": "LIVY_CONSOLE_SERVER=1 next build",
    "start": "LIVY_CONSOLE_SERVER=1 next start -H 0.0.0.0 -p 3000",
    "clean": "rm -rf out .next .next-server"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
