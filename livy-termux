#!/usr/bin/env bash
# Livy on Termux (Android): Bun, built-in SQLite, no compiler, no root.
#
# One command:
#
#   bash livy-termux
#
# The console and the listener are already built and committed, so a phone
# does not need to run Next.js. Server dependencies are pure JavaScript;
# SQLite comes from bun:sqlite and the DSP falls back to the JavaScript
# Metro implementation when there is no Android binary.
#
# Bun publishes glibc and musl builds and Android's libc is neither, so on
# Termux it runs under glibc-runner. Install it once:
#
#   pkg install git curl unzip glibc-repo && pkg install glibc-runner
#   curl -fsSL https://bun.sh/install | bash
#
# and this script wraps `bun` in `grun` when that is what the phone needs.
set -euo pipefail
cd "$(dirname "$0")"

say() { printf '\033[1;36m%s\033[0m\n' "$*"; }
fail() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }

BUN_BIN="${BUN_BIN:-$(command -v bun 2>/dev/null || true)}"
[ -n "$BUN_BIN" ] || { [ -x "$HOME/.bun/bin/bun" ] && BUN_BIN="$HOME/.bun/bin/bun"; }
[ -n "$BUN_BIN" ] || fail "bun is required: curl -fsSL https://bun.sh/install | bash"

# Does the binary start as it is? If not, and glibc-runner is here, use it.
if "$BUN_BIN" --version >/dev/null 2>&1; then
  bun() { "$BUN_BIN" "$@"; }
elif command -v grun >/dev/null 2>&1 && grun "$BUN_BIN" --version >/dev/null 2>&1; then
  bun() { grun "$BUN_BIN" "$@"; }
else
  fail "bun cannot start on this device — install glibc-runner: pkg install glibc-repo && pkg install glibc-runner"
fi

if [ ! -d server/node_modules ] || [ ! -f server/node_modules/ws/package.json ]; then
  say "Installing server dependencies (JavaScript only)…"
  (cd server && bun install --production)
fi

# A phone's home is the only writable place that survives a Termux restart.
export LIVY_DATA_DIR="${LIVY_DATA_DIR:-$HOME/.livy}"
mkdir -p "$LIVY_DATA_DIR"
# Only claim Android on an actual Android kernel: running this script on a
# desktop should get the server training budget, not the phone one.
if [ "$(uname -o 2>/dev/null || true)" = "Android" ] || [ -n "${TERMUX_VERSION:-}" ]; then
  export LIVY_PLATFORM="${LIVY_PLATFORM:-android}"
fi

say "Livy on Termux — data in $LIVY_DATA_DIR, console on http://localhost:${PORT:-${LIVY_PORT:-2333}}/"
cd server
if "$BUN_BIN" --version >/dev/null 2>&1; then
  # --smol: a smaller heap and a keener collector, for a 2 GB device.
  exec "$BUN_BIN" --smol src/index.ts "$@"
fi
exec grun "$BUN_BIN" --smol src/index.ts "$@"
