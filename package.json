{
  "name": "livy",
  "version": "1.0.0",
  "description": "Livy — a Discord music bot powered by NodeLink (formerly NodeCast).",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/config.js && node --check src/client.js"
  },
  "keywords": [
    "discord",
    "discord.js",
    "music",
    "nodelink",
    "lavalink",
    "fastlink"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@performanc/fastlink": "2.4.1-rc.1",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.0"
  }
}
