# Livy environment configuration
# Copy to .env and adjust. All values are optional unless noted.

# Server
HOST=0.0.0.0
PORT=2333
NODE_ENV=development
LOG_LEVEL=info

# Auth — if set, all /api/v1 routes require `Authorization: Bearer <API_KEY>`
# Leave empty to disable auth (development only).
API_KEY=

# Database — type: memory | sqlite | postgres
DATABASE_TYPE=memory
# sqlite: file path (default ./data/livy.db)
DATABASE_PATH=./data/livy.db
# postgres: connection string
DATABASE_URL=postgres://user:password@localhost:5432/livy

# Streaming
# Max concurrent listeners per station
MAX_LISTENERS_PER_STATION=100
# Upstream fetch timeout in ms
STREAM_TIMEOUT_MS=15000
# Enable native Rust audio pipeline when the addon is built
USE_NATIVE_AUDIO=true

# CORS — comma-separated origins, or * for all
CORS_ORIGINS=*
