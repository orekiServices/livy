# Livy environment configuration — copy to .env and adjust
# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# API authentication (optional). If set, clients must send:
#   Authorization: Bearer <API_KEY>
API_KEY=

# Database: memory | json | sqlite | postgres | mysql
DB_TYPE=memory
# json: file path; sqlite: file path; postgres/mysql: connection string
DB_URL=./data/livy.db
DB_POOL_SIZE=10

# Streaming
STREAM_DEFAULT_FORMAT=mp3
STREAM_MAX_LISTENERS_PER_STATION=1000
STREAM_BUFFER_SIZE=65536
STREAM_CONNECT_TIMEOUT_MS=10000

# Lavalink-v4 compatibility layer
LAVALINK_ENABLED=true
LAVALINK_PASSWORD=livy

# Logging: silent | error | warn | info | debug
LOG_LEVEL=info
