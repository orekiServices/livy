# ── Livy configuration ──────────────────────────────────────────────
# Copy to .env and fill in:  cp .env.example .env

# Discord bot token (required)
DISCORD_TOKEN=

# Prefix for text commands (slash commands always work)
PREFIX=!

# ── NodeLink node ───────────────────────────────────────────────────
# NodeLink defaults: port 3000, password "youshallnotpass"
# (2333 is the *Lavalink* default — using it against NodeLink is a
# common misconfiguration, so Livy defaults to 3000.)
NODELINK_HOST=127.0.0.1
NODELINK_PORT=3000
NODELINK_PASSWORD=youshallnotpass
NODELINK_SECURE=false

# Multiple nodes (optional, overrides the single-node vars above).
# Format: identifier,host,port,password,secure  — nodes separated by ";"
# NODELINK_NODES=main,127.0.0.1,3000,youshallnotpass,false;backup,10.0.0.2,3000,youshallnotpass,false

# ── Behaviour ───────────────────────────────────────────────────────
# Default search source prefix when the query is not a URL.
# NodeLink prefixes: ytsearch: ytmsearch: scsearch: spsearch: dzsearch: …
DEFAULT_SEARCH_SOURCE=ytsearch:

# Max tracks enqueued from a single playlist/album result.
MAX_PLAYLIST_LENGTH=100

# Seconds Livy stays in an empty voice channel before leaving (0 = never).
EMPTY_LEAVE_SECONDS=60

# Register slash commands on startup (true = global, may take up to 1h to
# propagate; set COMMANDS_GUILD_ID for instant guild-only registration).
REGISTER_COMMANDS=true
COMMANDS_GUILD_ID=
