{
  "name": "livy",
  "version": "3.10.0",
  "description": "Livy — Bun + Icecast-style multi-station internet radio in TypeScript: many sources, beatmatched automix, ICY metadata, REST + WebSocket API and its own Next.js console. One process, no transcoding tools.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./station": "./src/core/station.ts",
    "./sources": "./src/sources/index.ts",
    "./mp3": "./src/util/mp3.ts",
    "./metro": "./src/util/metro.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:js": "LIVY_DISABLE_METRO=1 bun test",
    "verify:console": "bun scripts/verify-console.ts",
    "build:web": "bun scripts/build-console.ts",
    "db": "bun scripts/db.ts",
    "db:info": "bun scripts/db.ts info",
    "db:migrate": "bun scripts/db.ts migrate",
    "bench:metro": "bun scripts/metro-bench.ts",
    "build:metro": "cd ../native/libmetro && cargo build --release && bun scripts/link-local.ts",
    "build:db": "cd ../native/metrodb && cargo build --release && bun scripts/link-local.ts",
    "train:setup": "python3 -m venv .venv && .venv/bin/pip install -r python/requirements.txt",
    "train:probe": ".venv/bin/python python/train.py --probe"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "mpg123-decoder": "^1.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.15",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "livy",
    "radio",
    "icecast",
    "icy",
    "mp3",
    "streaming",
    "automix",
    "beatmatch",
    "soundcloud",
    "audius",
    "broadcast",
    "typescript"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.4"
}
