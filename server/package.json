{
  "name": "livy",
  "version": "3.10.0",
  "description": "Livy — Bun + Icecast-style multi-station internet radio: many sources, beatmatched automix, ICY metadata, REST + WebSocket API and its own web console. One process, no transcoding tools.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./station": "./src/core/station.js",
    "./sources": "./src/sources/index.js",
    "./mp3": "./src/util/mp3.js",
    "./metro": "./src/util/metro.js"
  },
  "scripts": {
    "start": "bun src/index.js",
    "dev": "bun --watch src/index.js",
    "test": "bun test",
    "test:js": "LIVY_DISABLE_METRO=1 bun test",
    "build:web": "bun scripts/build-console.js",
    "db": "bun scripts/db.js",
    "db:info": "bun scripts/db.js info",
    "db:migrate": "bun scripts/db.js migrate",
    "bench:metro": "bun scripts/metro-bench.js",
    "build:metro": "cd ../native/libmetro && cargo build --release && bun scripts/link-local.js",
    "build:db": "cd ../native/metrodb && cargo build --release && bun scripts/link-local.js",
    "train:setup": "python3 -m venv .venv && .venv/bin/pip install -r python/requirements.txt",
    "train:probe": ".venv/bin/python python/train.py --probe"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "mpg123-decoder": "^1.0.3",
    "ws": "^8.18.0"
  },
  "keywords": [
    "livy",
    "radio",
    "icecast",
    "icy",
    "mp3",
    "streaming",
    "automix",
    "beatmatch",
    "soundcloud",
    "audius",
    "broadcast"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.4"
}
