# Livy — environment
#
# Everything here can also live in config.json (see config.example.json); the
# environment wins where both are set. The pre-rename `NODECAST_*` spellings
# are still understood, so an existing unit file keeps working.

PORT=2333
HOST=0.0.0.0
SERVER_PASSWORD=           # empty = open; set it and give the same value to the web app
LOG_LEVEL=info

# Sources
SOUNDCLOUD_CLIENT_ID=      # empty = auto-scraped from soundcloud.com, refreshed on 401/403
AUDIUS_APP_NAME=livy       # the app_name sent to Audius discovery nodes
SONGLINK_API_KEY=          # optional — anonymous Odesli access is rate-limited, not forbidden

# DJ models — on by default, trained while stations are on air
LIVY_MODEL_DIR=            # empty = $LIVY_DATA_DIR/models
LIVY_AUTO_TRAIN=1          # 0 turns background training off
LIVY_MODEL_FAST=1          # small nets, CPU
LIVY_HF_REPO=              # you/livy-models — created private
HF_TOKEN=                  # or LIVY_HF_TOKEN; never leaves the node

# Engine switches (set to 1 to force the fallback path)
# LIVY_DISABLE_METRO=1     # ignore the libmetro binary, use the JavaScript re-framer
# LIVY_DISABLE_METRODB=1   # ignore MetroDB, use bun:sqlite
